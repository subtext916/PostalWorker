{
  "name": "postalworker-es",
  "version": "5.0.0",
  "description": "Typed messaging between windows, tabs, iframes, popups and a SharedWorker",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker-script": {
      "types": "./dist/worker-script.d.ts",
      "default": "./dist/worker-script.js"
    },
    "./PostalSharedWorker.js": "./dist/PostalSharedWorker.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/worker/tsconfig.json --noEmit",
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:browser": "npm run build && node --test test/browser/*.test.mjs",
    "test:types": "tsc -p test/types/tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run test:types && npm run test:unit && npm run test:browser",
    "prepublishOnly": "npm test",
    "demo-server": "node server.js",
    "demo:react": "npm run build && node scripts/copy-demo.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "postMessage",
    "SharedWorker",
    "BroadcastChannel",
    "eventbus",
    "cross-window",
    "typescript"
  ],
  "author": "Russ Stratfull <russ@russandsonya.com> (http://russandsonya.com/russ)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subtext916/PostalWorker.git"
  },
  "bugs": {
    "url": "https://github.com/subtext916/PostalWorker/issues"
  },
  "homepage": "https://github.com/subtext916/PostalWorker#readme",
  "dependencies": {
    "http-server": "^14.1.1"
  }
}
